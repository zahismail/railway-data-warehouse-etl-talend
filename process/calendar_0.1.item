    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="sdk" expression="Numeric.sequence(&quot;s1&quot;, 1, 1)" type="id_Integer"/>
        <mapperTableEntries name="DT_jour" expression="TalendDate.addDate(context.startDate, row1.ID, &quot;dd&quot;)" type="id_Date"/>
        <mapperTableEntries name="annee" expression="TalendDate.getPartOfDate(&quot;yyyy&quot;, Var.DT_jour)" type="id_Integer"/>
        <mapperTableEntries name="mois" expression="TalendDate.getPartOfDate(&quot;MM&quot;, Var.DT_jour)" type="id_Integer"/>
        <mapperTableEntries name="trimestre" expression="(Var.mois - 1) / 3 + 1" type="id_Integer"/>
        <mapperTableEntries name="jour_semaine" expression="TalendDate.getPartOfDate(&quot;EEEE&quot;, Var.DT_jour)" type="id_Integer"/>
        <mapperTableEntries name="saison" expression="(Var.mois >= 3 &amp;&amp; Var.mois &lt;= 5) ? &quot;Printemps&quot; : (Var.mois >= 6 &amp;&amp; Var.mois &lt;= 8) ? &quot;Eté&quot; : (Var.mois >= 9 &amp;&amp; Var.mois &lt;= 11) ? &quot;Automne&quot; : &quot;Hiver&quot;" type="id_String"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="out1">
        <mapperTableEntries name="sdk" expression="Var.sdk " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="DT_jour" expression="Var.DT_jour " type="id_Date" nullable="true"/>
        <mapperTableEntries name="annee" expression="Var.annee " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="mois" expression="Var.mois " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="trimestre" expression="Var.trimestre " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="jour_semaine" expression="Var.jour_semaine " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="saison" expression="Var.saison " type="id_String" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="ID" type="id_Integer" nullable="true"/>
      </inputTables>
    </nodeData>
  </node>
